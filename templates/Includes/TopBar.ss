<div id="share-draft-content-message">
	<div class="message">
		<%t SilverStripe\ShareDraftContent\Controllers\ShareDraftController.TOPBAR_CURRENTLY_DRAFT "You are viewing the <em>draft state</em> of this page, any page you navigate to will be the <em>published state</em>." %>
		<details class="extra-information"><summary class="extra-information__control"><%t SilverStripe\ShareDraftContent\Controllers\ShareDraftController.TOPBAR_HOW_IT_WORKS "How it works." %></summary>
            <div class="extra-information__expanded">
                <%t SilverStripe\ShareDraftContent\Controllers\ShareDraftController.TOPBAR_TWO_STATES "Pages appear in two states:" %>
                <dl class="extra-information__list">
                    <dt class="extra-information__list-title"><%t SilverStripe\ShareDraftContent\Controllers\ShareDraftController.DRAFT_STATE "Draft state" %></dt>
                    <dd class="extra-information__list-details"><%t SilverStripe\ShareDraftContent\Controllers\ShareDraftController.TOPBAR_DRAFT_DESC "contains content which is yet to be published. While viewing draft pages, a message will appear to inform you of this." %></dd>
                    <dt class="extra-information__list-title"><%t SilverStripe\ShareDraftContent\Controllers\ShareDraftController.PUBLISHED_STATE "Published state" %></dt>
                    <dd class="extra-information__list-details"><%t SilverStripe\ShareDraftContent\Controllers\ShareDraftController.TOPBAR_PUBLISHED_DESC "contains content which has been published. As a result, you will not be notified of this, and will see the live version of the site." %></dd>
                </dl>
            </div>
        </details>
	</div>
</div>



